# =====================================================================
# WALKIN RECRUITMENT PLATFORM - HOSTINGER / SHARED HOSTING .ENV
# Copy this file to .env and fill in your MySQL & SMTP credentials
# =====================================================================

APP_NAME="WALKIN"
APP_ENV="production"
APP_URL="https://yourdomain.com"

# Hostinger MySQL Database Credentials
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="u123456789_walkin"
DB_USER="u123456789_walkinuser"
DB_PASS="YourStrongDatabasePassword123!"

# Google Identity Services / OAuth 2.0 Client
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Hostinger SMTP Email Configuration (Free with your shared hosting plan)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="ssl"
SMTP_USER="notifications@yourdomain.com"
SMTP_PASS="YourEmailAccountPassword"
SMTP_FROM_NAME="WALKIN Recruitment"
SMTP_FROM_EMAIL="notifications@yourdomain.com"

# Storage Settings
STORAGE_DIR="storage"
MAX_RESUME_SIZE_MB="5"
